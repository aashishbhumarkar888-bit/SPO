rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Currently NO authenticated identity model exists (Phase 2 pending).
    // Therefore, all access to sensitive collections is blocked to prevent data leakage.
    // This intentionally breaks functionality that relies on insecure public access.
    
    match /farmers/{farmerId} {
      allow read, write: if false;
    }

    match /tokens/{tokenId} {
      allow read, write: if false;
    }

    match /staff_users/{staffId} {
      allow read, write: if false;
    }

    match /audit_logs/{logId} {
      allow read, write: if false;
    }
  }
}
