rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function
    function isSignedIn() {
      return request.auth != null;
    }

    // Farmers directory:
    // Requires authenticated access for querying or modifying farmer records
    match /farmers/{farmerId} {
      allow read, write: if isSignedIn();
    }

    // Tokens & Mandi passes:
    // Only authenticated sessions can create or inspect queue passes
    match /tokens/{tokenId} {
      allow read, write: if isSignedIn();
    }

    // Staff and administrators:
    match /staff_users/{staffId} {
      allow read, write: if isSignedIn();
    }

    // Audit logs: append-only for authenticated operations
    match /audit_logs/{logId} {
      allow read, create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}

