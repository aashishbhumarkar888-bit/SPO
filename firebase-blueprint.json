{
  "entities": {
    "farmers": {
      "title": "Registered Farmers",
      "description": "Registered citizen farmers with land records, mobile, and Aadhaar info",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "kisanId": { "type": "string" },
        "aadhaarLast4": { "type": "string" },
        "fullName": { "type": "string" },
        "fullNameHi": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "village": { "type": "string" },
        "villageHi": { "type": "string" },
        "district": { "type": "string" },
        "state": { "type": "string" },
        "bankAccount": { "type": "string" },
        "bankName": { "type": "string" },
        "ifsc": { "type": "string" },
        "pmKisanBeneficiary": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "kisanId", "fullName", "phone"]
    },
    "tokens": {
      "title": "Agri Tokens & Mandi Passes",
      "description": "Digital slot tokens and arrival passes generated by farmers or mandi supervisors",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tokenNumber": { "type": "string" },
        "farmerId": { "type": "string" },
        "farmerName": { "type": "string" },
        "farmerPhone": { "type": "string" },
        "kisanId": { "type": "string" },
        "serviceType": { "type": "string" },
        "centreId": { "type": "string" },
        "centreName": { "type": "string" },
        "status": { "type": "string" },
        "counterAssigned": { "type": "number" },
        "priority": { "type": "boolean" },
        "scheduledTime": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tokenNumber", "farmerId", "status"]
    },
    "staff_users": {
      "title": "Staff & Admin Directory",
      "description": "Operational supervisors, field officers, and state policy super admins",
      "type": "object",
      "properties": {
        "staffId": { "type": "string" },
        "role": { "type": "string", "enum": ["supervisor", "superadmin"] },
        "fullName": { "type": "string" },
        "designation": { "type": "string" },
        "centreId": { "type": "string" },
        "centreName": { "type": "string" },
        "email": { "type": "string" },
        "mobile": { "type": "string" },
        "clearanceLevel": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["staffId", "role", "fullName"]
    },
    "audit_logs": {
      "title": "Security & Action Audit Logs",
      "description": "Immutable security logs for farmer authentications, weighbridge passes, and DBT disbursements",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "actorRole": { "type": "string" },
        "actorId": { "type": "string" },
        "targetEntity": { "type": "string" },
        "targetId": { "type": "string" },
        "description": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "action", "actorRole", "timestamp"]
    }
  }
}
