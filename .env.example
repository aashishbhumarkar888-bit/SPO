# ==========================================
# SERVER CONFIGURATION
# ==========================================
NODE_ENV=production
PORT=3000

# ==========================================
# AUTHENTICATION (CRITICAL)
# ==========================================
# Minimum 32 characters securely random string
JWT_SECRET=your_secure_random_string_here

# Stringified JSON object of the Firebase Service Account
# Required for verifying staff logins securely.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key":"...","client_email":"..."}

# ==========================================
# EMAIL OTP SMTP CONFIGURATION (Optional for dev, required for prod)
# ==========================================
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="AgriSeva Mandi Portal <noreply@agriseva.gov.in>"

# ==========================================
# DEPLOYMENT CONFIGURATION
# ==========================================
ALLOWED_ORIGIN=https://spo-snowy.vercel.app
